# ==============================================================================
# VulnX: Enterprise AI-Assisted Vulnerability Management Platform
# Environment Configuration Template (Placeholders Only — Do Not Commit Secrets)
# ==============================================================================

# Application & Session Security
APP_SECRET_KEY=

# Database Persistence (SQLite with WAL mode / PostgreSQL ready)
DATABASE_PATH=./scan_history.db
VULNX_DATABASE_PATH=./scan_history.db
VULNGRAPH_DATABASE_PATH=./scan_history.db
VULNGRAPH_SQLITE_BUSY_TIMEOUT_MS=15000

# Threat Intelligence Enrichment (FIRST.org EPSS & CISA KEV)
# Set to 1 to enable live FIRST EPSS API lookups (Cached locally in data/ for 24h)
VULNX_THREAT_ENRICHMENT=1
VULNGRAPH_THREAT_ENRICHMENT=1
# Optional NVD API Key (Increases rate limit from 5 requests/30s to 50 requests/30s)
NVD_API_KEY=

# AI Security Copilot Configuration
# Provider selection: 'auto' (Gemini -> Ollama -> Deterministic), 'gemini', 'ollama', or 'deterministic'
VULNX_AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Scanner Subprocess Timeouts (seconds)
VULNGRAPH_TRIVY_TIMEOUT=1800
VULNGRAPH_NMAP_TIMEOUT=120
VULNGRAPH_ZAP_TIMEOUT=900

# Cryptographic Audit Checkpoint (Must be stored and protected outside SQLite database)
AUDIT_CHECKPOINT_SECRET=
VULNGRAPH_AUDIT_CHECKPOINT_KEY=
VULNGRAPH_AUDIT_CHECKPOINT_FILE=
